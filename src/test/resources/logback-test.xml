<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 单测日志中突出业务覆盖：提交、拒绝原因、幂等、漂移判定、基线更新 -->
    <logger name="com.github.lechandonga.dataqualitydriftmonitorjava" level="INFO"/>
    <logger name="com.github.lechandonga.dataqualitydriftmonitorjava.tests.support.BusinessTestWatcher" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
